{
  "name": "agent-flow",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "AI Agent Workflow Orchestrator - 总控平台",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "dev:client": "yarn workspace @agent-flow/client dev",
    "dev:server": "yarn workspace @agent-flow/server dev",
    "lint": "eslint .",
    "build": "yarn workspace @agent-flow/client build && yarn workspace @agent-flow/server build",
    "predeploy": "yarn workspace @agent-flow/client build && cp packages/client/public/404.html packages/client/dist/404.html",
    "deploy": "gh-pages -d packages/client/dist",
    "sync-context": "tsx scripts/sync-context.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.2",
    "typescript": "~6.0.2"
  }
}
